+packageJSON : Package -> List (String, JSON)
+packageJSON (Git u c i p t n) = [("type",JString "git"),("url",JString (interpolate u)),("rev",JString (interpolate c)),("ipkg",JString (interpolate i))]
+packageJSON (Local d i p t) = [("type",JString "local"),("path",JString (interpolate d)),("ipkg",JString (interpolate i))]
+packageJSON (Core c) = [("type",JString "core")]
+
+libraryJSON : ResolvedLib U -> JSON
+libraryJSON rl = JObject $ [("name",JString (value rl.name)),("hash",JString (interpolate rl.hash)),("package",JString rl.desc.desc.name),("version",maybe JNull (JString . show) (the (Maybe PkgVersion) rl.desc.desc.version)),("content",JString rl.desc.cont),("dependencies",JArray (map (JString . value) (dependencies rl)))] ++ packageJSON rl.pkg
+
+projectJSON : Desc t -> JSON
+projectJSON description = JObject [("name",JString description.desc.name),("version",maybe JNull (JString . show) (the (Maybe PkgVersion) description.desc.version)),("executable",maybe JNull (JString . interpolate) (exec description)),("content",JString description.cont),("path",JString (interpolate description.path)),("dependencies",JArray (map (JString . value) (dependencies description)))]
+
+export covering
+emitMetadata : HasIO io => String -> EitherT PackErr io ()
+emitMetadata raw = case AbsFile.parse raw of
+  Nothing => throwE (UnknownPkg "invalid-root-ipkg-path")
+  Just file => do
+    description <- parseIpkgFile file file
+    putStrLn ("PURIFIER_PROJECT=" ++ show (projectJSON description))
+
+export covering
+emitCapture : HasIO io => (env : Env) => EitherT PackErr io ()
+emitCapture = do
+  _ <- traverse resolveLib env.config.autoLibs
+  sm <- readIORef env.cache
+  putStrLn ("PURIFIER_SETTINGS=" ++ show (JObject [("applications",JArray (map (JString . value) env.config.autoApps)),("documentation",JBoolean env.config.withDocs)]))
+  putStrLn ("PURIFIER_GRAPH=" ++ show (JArray (map libraryJSON (values sm))))
+  putStrLn ("PURIFIER_COMPILER=" ++ show (JObject [("url",JString (interpolate env.db.idrisURL)),("rev",JString (interpolate env.db.idrisCommit)),("version",JString (interpolate env.db.idrisVersion)),("collection",JString (interpolate env.config.collection))]))
+
+export covering
+captureDependencies : HasIO io => (env : Env) => CurDir => Maybe PkgOrIpkg -> EitherT PackErr io ()
+captureDependencies pkg = do
+  selected <- refinePkg pkg
+  description <- findAndParseLocalIpkg selected
+  _ <- resolveLib "prelude"
+  _ <- resolveLib "base"
+  _ <- resolveLib "network"
+  _ <- traverse resolveLib (dependencies description)
+  putStrLn ("PURIFIER_PROJECT=" ++ show (projectJSON description))
+  emitCapture
+
 export covering
 resolveAll :
      {auto h : HasIO io}
   -> {auto env : Env}
   -> EitherT PackErr io (SortedMap PkgName (ResolvedLib U), List QPkg)
 resolveAll = do
-  ps <- traverse resolve pkgNames
+  selected <- getEnv "PACK_PURIFIER_CAPTURE"
+  names <- case selected of
+    Nothing => pure pkgNames
+    Just n => do
+      _ <- resolveLib "prelude"
+      _ <- resolveLib "network"
+      _ <- resolveLib (MkPkgName n)
+      sm <- readIORef env.cache
+      pure (keys sm)
+  ps <- traverse resolve names
   sm <- readIORef env.cache
+  case selected of
+    Nothing => pure ()
+    Just _ => emitCapture
   pure (sm, ps)
 
 
